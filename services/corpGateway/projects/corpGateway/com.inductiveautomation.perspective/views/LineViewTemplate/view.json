{
  "custom": {
    "key": [
      "Site1",
      "Area1",
      "Line 1"
    ]
  },
  "params": {
    "udtPath": "[MQTT Engine]Edge Nodes/Site1/Area1/Line 1"
  },
  "propConfig": {
    "custom.key": {
      "binding": {
        "config": {
          "path": "view.params.udtPath"
        },
        "transforms": [
          {
            "code": "\tbreadCrumb\u003dvalue.strip(\"[MQTT Engine]Edge Nodes/\").split(\"/\")\n\treturn breadCrumb",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.udtPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 217,
      "width": 283
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label_0"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.udtPath"
              },
              "transforms": [
                {
                  "code": "\tbreadCrumb\u003dvalue.strip(\"[MQTT Engine]Edge Nodes/\").split(\"/\")\n\treturn \u0027{}/{}\u0027.format(breadCrumb[0],breadCrumb[1])",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "margin": "4px",
            "overflow": "auto"
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.udtPath"
              },
              "transforms": [
                {
                  "code": "\treturn value.strip(\"[MQTT Engine]Edge Nodes/\").split(\"/\")[-1]",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "margin": "4px",
            "overflow": "auto"
          },
          "textStyle": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "RadioGroup"
        },
        "propConfig": {
          "props.radios[0].selected": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "udtPath": "{view.params.udtPath}"
                },
                "tagPath": "{udtPath}/running"
              },
              "type": "tag"
            }
          }
        },
        "props": {
          "index": null,
          "justify": "center",
          "radios": [
            {
              "text": "Running",
              "value": "Running"
            }
          ],
          "selectedIcon": {
            "color": {
              "enabled": "#008000"
            }
          },
          "style": {
            "pointer-events": "none"
          },
          "value": ""
        },
        "type": "ia.input.radio-group"
      },
      {
        "meta": {
          "name": "MultiStateButton"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.controlValue": {
            "binding": {
              "config": {
                "bidirectional": true,
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "udtPath": "{view.params.udtPath}"
                },
                "tagPath": "{udtPath}/hoa"
              },
              "type": "tag"
            }
          },
          "props.indicatorValue": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "udtPath": "{view.params.udtPath}"
                },
                "tagPath": "{udtPath}/hoa"
              },
              "type": "tag"
            }
          }
        },
        "props": {
          "states": [
            {
              "selectedStyle": {
                "backgroundColor": "#FFF275",
                "classes": ""
              },
              "text": "Hand",
              "unselectedStyle": {
                "classes": ""
              },
              "value": 2
            },
            {
              "selectedStyle": {
                "backgroundColor": "#F84553",
                "classes": ""
              },
              "text": "Off",
              "unselectedStyle": {
                "classes": ""
              },
              "value": 0
            },
            {
              "selectedStyle": {
                "backgroundColor": "#7CEA9C",
                "classes": ""
              },
              "text": "Auto",
              "unselectedStyle": {
                "classes": ""
              },
              "value": 1
            }
          ],
          "style": {
            "margin": "4px",
            "overflow": "auto"
          }
        },
        "type": "ia.input.multi-state-button"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "props": {
              "style": {
                "marginRight": "4px"
              },
              "text": "Speed:"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Label_0"
            },
            "position": {
              "basis": "50px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "udtPath": "{view.params.udtPath}"
                    },
                    "tagPath": "{udtPath}/speed"
                  },
                  "transforms": [
                    {
                      "formatType": "numeric",
                      "formatValue": "#.000",
                      "type": "format"
                    }
                  ],
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "borderStyle": "solid",
                "borderWidth": "0.5px",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Speed"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "margin": "4px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--neutral-30",
        "margin": "4px"
      }
    },
    "type": "ia.container.flex"
  }
}